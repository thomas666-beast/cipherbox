.cover_db/
nytprof.out

# --- Application Runtime & Logs ---
*.log
*.pid
/cipherbox.pid
/hypnotoad.pid
/run/
.env

# --- Secure Storage (Files encrypted at rest) ---
# Never commit user uploads or encrypted paste blobs
/storage/library/*.bin
/storage/pastes/*.bin
/storage/tmp/

# --- Database ---
# (Assuming local dumps or temporary data)
*.sqlite
*.db
dump.sql

# --- Frontend (Vue / Vite / Node) ---
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.cache/
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# --- Rust / Crypto Engines ---
# Ignore compiled binaries and WASM output
/target/
**/target/
**/Cargo.lock
**/pkg/
*.wasm
*.rlib
*.rmeta
*.d
# Keep source files, but ignore local build outputs
/crypto/client-wasm/target/
/crypto/server-native/target/
/frontend/src/pqc/*.wasm
/frontend/src/pqc/*.js
/bin/cipherbox-pqc-verify
/bin/cipherbox-pqc-wrap

# --- IDE / Editors ---
# VS Code
.vscode/
*.code-workspace

# JetBrains (IntelliJ, PhpStorm, WebStorm, etc.)
