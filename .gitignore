# --- Carton / Perl Dependencies ---
/local/
/.build/
cpanfile.snapshot.bak

# --- Perl Build Artifacts ---
/Makefile
/Makefile.old
/blib/
/_build/
/pm_to_blib
*.bs
*.o
*.so
*.a
*.c
*.h
*.xs
*.tar.gz
*.tar.bz2
*.zip
