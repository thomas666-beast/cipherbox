#!/usr/bin/env perl
use strict;
use warnings;
use lib 'lib';
use Mojo::Pg;
use Mojo::File 'path';
use Cipherbox::Model::User;

my $root      = path(__FILE__)->dirname->dirname;
my $conf_file = $root->child('cipherbox.conf');
my $config    = do $conf_file->to_string;
die "Cannot read $conf_file: $!" unless defined $config;

my $env = $ENV{CIPHERBOX_ENV} // 'development';
my $dsn = $env eq 'test'
    ? $config->{test}{pg}{dsn}
    : $config->{pg}{dsn};

my ($username, $password) = @ARGV;
die "Usage: $0 <username> <password>\n"
    unless $username and $password;

my $pg = Mojo::Pg->new($dsn);
my $users = Cipherbox::Model::User->new(pg => $pg);

my $existing = $users->find_by_username($username);
if ($existing) {
    if (($existing->{role} // '') eq 'admin') {
        print "User '$username' already exists and is admin.\n";
        exit 0;
    }
    $pg->db->query("UPDATE users SET role = 'admin' WHERE id = ?", $existing->{id});
    print "User '$username' promoted to admin.\n";
    exit 0;
}

my $user = $users->create($username, $password, 'admin');
print "Admin '$username' created (id=$user->{id}).\n";
